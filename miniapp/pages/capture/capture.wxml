<view class="container">
  <view class="card">
    <view class="card-title">随手记</view>
    <view class="muted">路上记一条想法，回到电脑自动同步进 Hub。</view>
    <textarea class="input" style="width:100%;box-sizing:border-box;min-height:140rpx" placeholder="写点什么…" value="{{text}}" bindinput="onInput" />
    <button class="btn" bindtap="submit" disabled="{{saving}}">{{saving ? '记录中…' : '记录'}}</button>
    <text class="muted" wx:if="{{queued}}"> 离线暂存 {{queued}} 条</text>
  </view>

  <view class="card item" wx:for="{{captures}}" wx:key="id">
    <view class="item-text">{{item.text}}</view>
    <view class="muted">{{item.day}}</view>
  </view>

  <view class="empty" wx:if="{{error}}">{{error}}</view>
  <view class="empty" wx:elif="{{!captures.length && !queued}}">还没有随手记。</view>
</view>
