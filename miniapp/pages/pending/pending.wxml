<view class="container">
  <view class="card">
    <view class="card-title">待继续 · {{day}}</view>
    <view class="muted">路上快速 triage，点「复制」把事项带走。</view>
  </view>

  <view class="empty" wx:if="{{error}}">{{error}}</view>

  <block wx:elif="{{!loading}}">
    <view class="card item" wx:for="{{items}}" wx:key="conversation_id">
      <view class="row">
        <view class="item-title">{{item.title || item.text}}<text class="src-tag">{{item.source}}</text></view>
        <button class="btn ghost" size="mini" data-text="{{item.text || item.title}}" bindtap="copy">复制</button>
      </view>
      <view class="item-text">{{item.text}}</view>
    </view>
    <view class="empty" wx:if="{{!items.length}}">今天暂无待继续事项。</view>
  </block>

  <view class="empty" wx:elif="{{loading}}">加载中…</view>
</view>
