page {
  background: #f5f2ea;
  color: #2b2a26;
  font-size: 28rpx;
  line-height: 1.6;
}

.container { padding: 24rpx; }

.card {
  background: #fffdf8;
  border: 1rpx solid #e5e0d3;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(60, 50, 30, 0.05);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.muted { color: #8a8578; font-size: 24rpx; }

.section-label {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  color: #1f3b34;
  background: rgba(31, 59, 52, 0.08);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin: 16rpx 0 8rpx;
}

.item { padding: 14rpx 0; border-bottom: 1rpx dashed #e5e0d3; }
.item:last-child { border-bottom: none; }
.item-title { font-weight: 600; font-size: 28rpx; }
.item-text { color: #55524a; font-size: 25rpx; margin-top: 4rpx; }

.src-tag {
  display: inline-block;
  font-size: 20rpx;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 10rpx;
  background: rgba(45, 146, 125, 0.12);
  color: #2d927d;
  vertical-align: middle;
}

.empty { text-align: center; color: #8a8578; padding: 60rpx 0; }

.btn {
  display: inline-block;
  background: #1f3b34;
  color: #fff;
  border-radius: 12rpx;
  padding: 14rpx 32rpx;
  font-size: 28rpx;
  margin-right: 16rpx;
}
.btn.ghost { background: transparent; color: #1f3b34; border: 1rpx solid #1f3b34; }
.btn[disabled] { opacity: 0.5; }

.input {
  background: #fff;
  border: 1rpx solid #ddd7c8;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.row { display: flex; align-items: center; justify-content: space-between; }
